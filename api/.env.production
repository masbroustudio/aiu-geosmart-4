# GeoUMKM Smart v4.0 - Production Environment
# Set these securely in Azure Key Vault or GitHub Secrets

# Database Configuration (Azure PostgreSQL)
DB_HOST=${DB_HOST}
DB_PORT=5432
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
DB_NAME=geoumkm
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=2000
DB_IDLE_TIMEOUT=30000
DB_SSL=true

# JWT Configuration
JWT_SECRET=${JWT_SECRET}
JWT_EXPIRY=24h

# Environment
NODE_ENV=production
DEBUG=false

# Azure Configuration
AZURE_SUBSCRIPTION_ID=${AZURE_SUBSCRIPTION_ID}
AZURE_RESOURCE_GROUP=rg-geoumkm-v2
AZURE_FUNCTION_APP_NAME=func-geoumkm-api
